<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <AssemblyName>Vfs.UnityWorker</AssemblyName>
    <RootNamespace>Vfs.UnityWorker</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AnimeStudio.Core\Vfs.AnimeStudio.Core.csproj" />
    <ProjectReference Include="..\Endfield.Extensions\Vfs.Endfield.Extensions.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\artifacts\native\x64\acl_endfield.dll')">
    <Content Include="..\..\artifacts\native\x64\acl_endfield.dll"
             Link="x64\acl_endfield.dll"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
